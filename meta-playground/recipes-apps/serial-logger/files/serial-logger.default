# /etc/default/serial-logger — runtime settings for serial-logger@.service.
#
# Read via EnvironmentFile= in the unit, which is parsed AFTER the unit's own
# Environment= lines, so anything set here overrides the built-in defaults.
# Everything is commented out below, which means the defaults apply; the file
# exists so that changing the baud rate on a deployed box is an edit and a
# `systemctl restart`, not an image rebuild.
#
# systemd parses this as a simple KEY=value list, NOT as shell. There is no
# command substitution, no variable expansion, no `export`. Quotes are
# stripped, but that is the extent of it.

# Line speed of the device being logged. Must be one of the rates in
# baud_to_speed() in serial-logger.c: 9600, 19200, 38400, 57600, 115200,
# 230400, 460800, 921600. Anything else is rejected at startup with a clear
# message rather than being silently rounded.
#LOGGER_BAUD=115200

# Where session logs are written. If you change this, change LogsDirectory=
# in the unit to match — that is what creates the directory and makes it
# writable under ProtectSystem=strict. A path outside /var/log will need
# ReadWritePaths= adding instead.
#LOGGER_DIR=/var/log/serial-logger

# --- Self-imposed disk limits (session 27) --------------------------------
#
# WHY THESE EXIST: the adapter cannot be unplugged without resetting this
# board, so without rotation a capture grows forever. Measured on hardware:
# ~77 bytes/sec, about 6.7 MB/day, against 29.5 MB free on a 100 MB rootfs.
# That is roughly four days to a full disk, and a full rootfs on an
# unattended logger is a board you may not be able to ssh into to fix.
#
# A bigger partition does not fix this -- any fixed amount of space loses to
# unbounded growth, it only moves the date. Bounding the growth works at any
# size.
#
# Bytes. 0 disables the limit entirely.

# Rotate to a new file once the current one reaches this size.
#LOGGER_MAX_FILE_BYTES=4194304

# --- The captures partition (session 28) -----------------------------------
#
# On the Zero W, /var/log/serial-logger is now its own partition, grown on
# first boot to fill the card. How big that is depends on the card, so the
# limit that protects it is expressed as FREE SPACE rather than bytes used.
#
# Before each new file, delete this device's OLDEST captures until at least
# this much of the filesystem is free. Either a percentage of the filesystem
# ("10%") or a byte count ("1073741824"). 0 disables it. Re-measured at every
# rotation, so it follows the filesystem as it grows.
#
# Why free space and not "N% of the disk per device": two adapters with 90%
# each add up to 180%. Free space is one number for the whole partition, so
# any number of instances respect it together, while each still deletes only
# its OWN files. Every deletion is reported to the journal, and so is running
# out of own files to delete while the disk is still short.
#
# Like the budget below, this is enforced at rotation boundaries, so the
# open file can take free space up to LOGGER_MAX_FILE_BYTES below the line
# before it is trimmed. 10% of a 16 GB card is ~1.4 GB, which dwarfs that.
#LOGGER_KEEP_FREE=10%

# Optional per-device cap on the TOTAL size of this device's captures, in
# bytes. Off (0) by default since session 28. It was 16 MB while captures
# shared the 100 MB rootfs with the OS. Useful if one chatty device should
# not be allowed to push out another device's history.
#
# Enforced at rotation boundaries, so real usage can reach
# LOGGER_MAX_TOTAL_BYTES + LOGGER_MAX_FILE_BYTES before it is trimmed.
#LOGGER_MAX_TOTAL_BYTES=0

# To start a new file by hand at an interesting moment:
#     systemctl kill -s HUP serial-logger@ttyUSB0
# SIGHUP is the idiom logrotate uses. It is safe to repurpose here only
# because the port is opened O_NOCTTY, so a hangup on the wire can never be
# mistaken for an operator asking for a new file.

# NOTE: this applies to every instance. Per-device settings (one adapter at
# 9600, another at 115200) would be a drop-in on the specific instance:
#   /etc/systemd/system/serial-logger@ttyUSB0.service.d/baud.conf
# containing [Service] and Environment=LOGGER_BAUD=9600. systemd merges
# drop-ins for a concrete instance on top of the template.
